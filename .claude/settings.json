{
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "building-react-native-apps@callstack-agent-skills": true,
    "skills@swmansion": true
  },
  "extraKnownMarketplaces": {
    "swmansion": {
      "source": {
        "source": "github",
        "repo": "software-mansion-labs/skills"
      }
    },
    "callstack-agent-skills": {
      "source": {
        "source": "github",
        "repo": "callstackincubator/agent-skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" protect",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" lint",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" typecheck",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
