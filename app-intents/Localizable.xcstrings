{
  "sourceLanguage": "en",
  "strings": {
    "Today's Summary": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün Özeti"
          }
        }
      }
    },
    "Cars in progress, ready and delivered today, and today's collected payments.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün işlemdeki, hazır ve teslim edilen araçlar ile günün tahsilatı."
          }
        }
      }
    },
    "New Job": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni İş Emri"
          }
        }
      }
    },
    "Opens a new job. With a plate, the customer and vehicle are picked for you.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni iş emri açar. Plaka verirseniz müşteri ve araç sizin için seçilir."
          }
        }
      }
    },
    "Plate": {
      "extractionState": "manual",
      "localizations": {
