{
  "expo": {
    "name": "Otopoly",
    "slug": "otopoly-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "otopoly",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otopoly.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "associatedDomains": [
        "applinks:otopoly.app",
        "webcredentials:otopoly.app"
      ],
      "deploymentTarget": "17.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.otopoly.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/t/" },
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/q/" },
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/login/qr/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#EA6E43",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-xcode-cloud",
      "./plugins/with-scene-lifecycle",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F4",
          "dark": {
            "image": "./assets/brand/mark-dark.png",
            "backgroundColor": "#120E0C"
          }
        }
      ],
      "expo-asset",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.otopoly.app.widgets",
          "groupIdentifier": "group.com.otopoly.app",
          "widgets": [
            {
              "name": "OtopolyToday",
              "displayName": "Otopoly · Bugün",
              "description": "İşlemdeki, hazır ve teslim edilen araçlar ile günün tahsilatı.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            },
            {
              "name": "OtopolyGlance",
              "displayName": "Otopoly · Kilit Ekranı",
              "description": "Kilit ekranında aktif iş sayısı ve günün tahsilatı.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE-WITH-IOS-CLIENT-ID"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5e4bc16-f23b-4735-bd29-81f3355f02a8"
      }
    },
    "owner": "furkanmeclis"
  }
}
