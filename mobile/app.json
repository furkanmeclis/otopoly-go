{
  "expo": {
    "name": "Otopoly",
    "slug": "otopoly-mobile-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "otopoly",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otopoly.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CFBundleAllowMixedLocalizations": true
      },
      "associatedDomains": [
        "applinks:otopoly.app",
        "webcredentials:otopoly.app"
      ],
      "deploymentTarget": "17.0",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ]
      }
    },
    "locales": {
      "tr": "./assets/locales/tr.json",
      "en": "./assets/locales/en.json"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.otopoly.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/t/" },
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/q/" },
            { "scheme": "https", "host": "otopoly.app", "pathPrefix": "/login/qr/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#EA6E43",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Otopoly, web oturumunu onaylamak için QR kodu okutmak ve sözleşmelere araç fotoğrafı eklemek üzere kameranızı kullanır.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Otopoly, seçtiğiniz araç fotoğraflarını ve belgeleri sözleşmelere eklemek için fotoğraf arşivinize erişir.",
          "cameraPermission": "Otopoly, web oturumunu onaylamak için QR kodu okutmak ve sözleşmelere araç fotoğrafı eklemek üzere kameranızı kullanır.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-xcode-cloud",
      "@sentry/react-native",
      "./plugins/with-sentry-no-upload",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F4",
          "dark": {
            "image": "./assets/brand/mark-dark.png",
            "backgroundColor": "#120E0C"
          }
        }
      ],
      "expo-asset",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "enablePushNotifications": true,
          "bundleIdentifier": "com.otopoly.app.widgets",
          "groupIdentifier": "group.com.otopoly.app",
          "widgets": [
            {
              "name": "OtopolyToday",
              "displayName": "Otopoly · Bugün",
              "description": "İşlemdeki, hazır ve teslim edilen araçlar ile günün tahsilatı.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyQueue",
              "displayName": "Otopoly · Sıradaki araçlar",
              "description": "Hazır ve işlemdeki araçlar; dokunarak işi açın.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyCash",
              "displayName": "Otopoly · Kasa durumu",
              "description": "Günün tahsilatı, giren-çıkan ve kasa/banka bakiyeleri.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyWeek",
              "displayName": "Otopoly · Haftalık ciro",
              "description": "Son 7 günün tahsilatı, gün gün.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyAlerts",
              "displayName": "Otopoly · Uyarılar",
              "description": "Ödenmemiş teslimler, azalan stok, yenilemesi gelen abonelikler ve takip bekleyen yorumlar.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyAgenda",
              "displayName": "Otopoly · Bugünkü takvim",
              "description": "Günün sıradaki randevuları ve yapılacakları.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyGlance",
              "displayName": "Otopoly · Açık işler",
              "description": "Kilit ekranında açık iş sayısı ve günün tahsilatı.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyCollectedGlance",
              "displayName": "Otopoly · Tahsilat",
              "description": "Kilit ekranında günün tahsilatı.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyNewJob",
              "displayName": "Otopoly · Yeni iş",
              "description": "Kilit ekranından tek dokunuşla yeni iş açın.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              },
              "android": null
            },
            {
              "name": "OtopolyTodayAndroid",
              "displayName": "Otopoly · Bugün",
              "description": "İşlemdeki, hazır ve teslim edilen araçlar ile günün tahsilatı.",
              "ios": null,
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/today-widget.tsx"
              }
            },
            {
              "name": "OtopolyQueueAndroid",
              "displayName": "Otopoly · İş Kuyruğu",
              "description": "Günün sayıları ve sıradaki araçlar; liste kaydırılabilir.",
              "ios": null,
              "android": {
                "minWidth": 250,
                "minHeight": 180,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/queue-widget.tsx"
              }
            },
            {
              "name": "OtopolyCashAndroid",
              "displayName": "Otopoly · Kasa durumu",
              "description": "Günün tahsilatı, giren-çıkan ve kasa/banka bakiyeleri.",
              "ios": null,
              "android": {
                "minWidth": 180,
                "minHeight": 180,
                "targetCellWidth": 3,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/cash-widget.tsx"
              }
            },
            {
              "name": "OtopolyWeekAndroid",
              "displayName": "Otopoly · Haftalık ciro",
              "description": "Son 7 günün tahsilatı, gün gün.",
              "ios": null,
              "android": {
                "minWidth": 220,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/week-widget.tsx"
              }
            },
            {
              "name": "OtopolyAlertsAndroid",
              "displayName": "Otopoly · Uyarılar",
              "description": "Ödenmemiş teslimler, azalan stok, yenilemesi gelen abonelikler ve takip bekleyen yorumlar.",
              "ios": null,
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/alerts-widget.tsx"
              }
            },
            {
              "name": "OtopolyAgendaAndroid",
              "displayName": "Otopoly · Bugünkü takvim",
              "description": "Günün sıradaki randevuları ve yapılacakları.",
              "ios": null,
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/android/agenda-widget.tsx"
              }
            }
          ]
        }
      ],
      "expo-app-intents",
      "./plugins/with-app-intents-locales",
      "./plugins/with-widget-locales",
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE-WITH-IOS-CLIENT-ID"
        }
      ]
    ],
    "experiments": {
      "inlineModules": {
        "watchedDirectories": ["app-intents"]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5e4bc16-f23b-4735-bd29-81f3355f02a8"
      }
    },
    "owner": "furkanmeclis"
  }
}
