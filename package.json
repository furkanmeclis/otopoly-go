  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:mock": "esbuild scripts/smoke/mock-smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/mock-smoke.cjs --tsconfig=tsconfig.json --define:__DEV__=false --define:process.env.EXPO_PUBLIC_MOCK_LATENCY='\"0\"' --alias:@react-native-async-storage/async-storage=./scripts/smoke/stubs.js --alias:expo-secure-store=./scripts/smoke/stubs.js --alias:expo-localization=./scripts/smoke/stubs.js --log-level=warning && node node_modules/.cache/mock-smoke.cjs",
    "locales:sync": "node scripts/sync-locales.mjs",
    "api:generate": "npx -y openapi-typescript@7 ../../Projects/otopoly-go/backend/docs/openapi.yaml -o src/api/generated/api.d.ts",
    "test:smoke": "node scripts/smoke/run-all.mjs",
    "test:contract": "node scripts/contract/run.mjs"
  },
  "private": true
